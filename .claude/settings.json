{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(python3 *)",
      "Bash(python -m pytest *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(ruff *)",
      "WebSearch",
      "WebFetch(domain:musicbrainz.org)",
      "WebFetch(domain:api.setlist.fm)",
      "WebFetch(domain:kopis.or.kr)",
      "WebFetch(domain:openapi.kopis.or.kr)",
      "WebFetch(domain:wiki.musicbrainz.org)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secrets.py\"",
            "statusMessage": "시크릿 파일 검사 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
